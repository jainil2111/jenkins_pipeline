// Builds Wazuh .deb packages from YOUR forks, using the versions pinned in wazuh-platform.
// Jenkins job: build-wazuh   |   Script Path: wazuh/build/Jenkinsfile
// Runs on the node labelled "build" (needs Docker + docker compose + git). Packages are archived
// in Jenkins and (optionally) published to the lab apt repo on the Jenkins VM.

pipeline {
    agent { label 'build' }

    parameters {
        string(name: 'PLATFORM_REF', defaultValue: 'main', description: 'Branch/tag/commit of wazuh-platform to build (its latest commit pins all fork versions)')
        string(name: 'WAZUH_REF',    defaultValue: '',     description: 'Optional: branch/tag/commit of your wazuh fork (agent/manager) instead of the pinned commit. Empty = use the pin')
        booleanParam(name: 'BUILD_AGENT',     defaultValue: true,  description: 'Build wazuh-agent .deb')
        booleanParam(name: 'BUILD_MANAGER',   defaultValue: true,  description: 'Build wazuh-manager .deb')
        booleanParam(name: 'BUILD_INDEXER',   defaultValue: true,  description: 'Build wazuh-indexer .deb')
        booleanParam(name: 'BUILD_DASHBOARD', defaultValue: true,  description: 'Build wazuh-dashboard .deb')
        booleanParam(name: 'FORCE_REBUILD',   defaultValue: false, description: 'Ignore the package cache and rebuild every ticked component (use after changing the build scripts)')
        booleanParam(name: 'FORCE_DASHBOARD_PLATFORM', defaultValue: false, description: 'Rebuild the dashboard platform even if the wazuh-dashboard commit is unchanged (~25 min extra)')
        booleanParam(name: 'KEEP_DEBUG',      defaultValue: false, description: 'Also archive the -dbg packages (large)')
        string(name: 'JOBS', defaultValue: '6', description: 'Parallel compile jobs (-j) for agent/manager')
        booleanParam(name: 'PUBLISH', defaultValue: true, description: 'Publish packages to the lab apt repo (http://192.168.11.20/wazuh-repo/)')
    }

    options {
        timestamps()
        timeout(time: 6, unit: 'HOURS')          // a full first build of all 4 components is long
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '3'))
    }

    environment {
        PLATFORM_URL = 'https://github.com/jainil2111/wazuh-platform.git'
        SRC = "${WORKSPACE}/src"
        OUT = "${WORKSPACE}/out"
        CACHE_SH = "${WORKSPACE}/wazuh/build/scripts/pkg-cache.sh"   // reuse packages built from the same commit
    }

    stages {
        stage('Resolve pinned versions') {
            steps {
                sh '''
                    set -e
                    rm -rf platform && git clone --quiet "$PLATFORM_URL" platform
                    cd platform && git checkout --quiet "$PLATFORM_REF"
                    echo "wazuh-platform $PLATFORM_REF @ $(git rev-parse --short HEAD)"
                    for m in wazuh wazuh-indexer wazuh-dashboard wazuh-dashboard-plugins wazuh-security-dashboards-plugin; do
                        git ls-tree HEAD "$m" | awk '{print $3}'    > "../$m.sha"
                        git config -f .gitmodules "submodule.$m.url" > "../$m.url"
                        echo "  PINNED: $m @ $(cut -c1-10 "../$m.sha")"
                    done
                    if [ -n "$WAZUH_REF" ]; then
                        echo "$WAZUH_REF" > ../wazuh.sha
                        echo "  OVERRIDE: wazuh fork ref '$WAZUH_REF' (agent/manager)"
                    fi
                '''
            }
        }

        stage('Prepare output') {
            steps {
                // Old packages may be root-owned (written by containers); remove them via a container
                sh '''
                    mkdir -p "$OUT"
                    docker run --rm -v "$OUT:/out" debian:12-slim sh -c 'rm -rf /out/*'
                '''
            }
        }

        stage('Fetch wazuh source') {
            when { expression { params.BUILD_AGENT || params.BUILD_MANAGER } }
            steps {
                sh '''
                    set -e
                    mkdir -p "$SRC/wazuh" && cd "$SRC/wazuh"
                    [ -d .git ] || { git init --quiet && git remote add origin "$(cat "$WORKSPACE/wazuh.url")"; }
                    git remote set-url origin "$(cat "$WORKSPACE/wazuh.url")"
                    git fetch --quiet --depth 1 origin "$(cat "$WORKSPACE/wazuh.sha")"
                    git checkout --quiet --force FETCH_HEAD
                    git clean -fdxq
                    echo "Building from $(git rev-parse --short HEAD)"
                '''
            }
        }

        stage('Build agent') {
            when { expression { params.BUILD_AGENT } }
            steps {
                sh '''
                    set -e
                    KEY="$(cat "$WORKSPACE/wazuh.sha")"
                    # The cache is keyed by commit, so skip it when WAZUH_REF overrides the pin with a branch name
                    if [ -z "$WAZUH_REF" ] && bash "$CACHE_SH" get wazuh-agent "$KEY"; then exit 0; fi
                    cd "$SRC/wazuh/packages"
                    ./generate_package.sh -t agent -a amd64 --system deb \
                        -r "$BUILD_NUMBER" -j "$JOBS" --sources "$SRC/wazuh" -s "$OUT"
                    [ -n "$WAZUH_REF" ] || bash "$CACHE_SH" put wazuh-agent "$KEY" "$OUT"/wazuh-agent_*.deb
                '''
            }
        }

        stage('Build manager') {
            when { expression { params.BUILD_MANAGER } }
            steps {
                sh '''
                    set -e
                    KEY="$(cat "$WORKSPACE/wazuh.sha")"
                    if [ -z "$WAZUH_REF" ] && bash "$CACHE_SH" get wazuh-manager "$KEY"; then exit 0; fi
                    cd "$SRC/wazuh/packages"
                    ./generate_package.sh -t manager -a amd64 --system deb \
                        -r "$BUILD_NUMBER" -j "$JOBS" --sources "$SRC/wazuh" -s "$OUT"
                    [ -n "$WAZUH_REF" ] || bash "$CACHE_SH" put wazuh-manager "$KEY" "$OUT"/wazuh-manager_*.deb
                '''
            }
        }

        stage('Build indexer') {
            when { expression { params.BUILD_INDEXER } }
            steps {
                sh '''
                    set -e
                    IDX="$SRC/wazuh-indexer"
                    SHA="$(cat "$WORKSPACE/wazuh-indexer.sha")"
                    SHORT="$(echo "$SHA" | cut -c1-7)"
                    if bash "$CACHE_SH" get wazuh-indexer "$SHA"; then exit 0; fi

                    # Files may have been written by the build containers as another user: open them up first
                    if [ -d "$IDX" ]; then docker run --rm -v "$IDX:/x" debian:12-slim chmod -R a+rwX /x; fi
                    mkdir -p "$IDX" && cd "$IDX"
                    [ -d .git ] || git init --quiet
                    git remote remove origin 2>/dev/null || true
                    git remote add origin "$(cat "$WORKSPACE/wazuh-indexer.url")"
                    git fetch --quiet --depth 1 origin "$SHA"
                    git checkout --quiet --force FETCH_HEAD
                    git clean -fdq                 # keep ignored Gradle caches for faster rebuilds
                    rm -rf artifacts
                    # Pre-create the output folder: if Docker creates it for the bind mount it is root-owned
                    # and the build container's user gets "Permission denied"
                    mkdir -p artifacts
                    # Run as root in a container: files made by the build containers (e.g. .gradle) aren't ours to chmod
                    docker run --rm -v "$IDX:/x" debian:12-slim chmod -R a+rwX /x
                    VER="$(bash packaging_scripts/product_version.sh)"
                    echo "wazuh-indexer @ $SHORT, version $VER"

                    # Start build containers; ALWAYS stop them afterwards (they hold ~3 GB RAM)
                    (cd docker/ci && bash ./ci.sh up)
                    trap 'cd "$IDX/docker/ci" && bash ./ci.sh stop || true' EXIT
                    # Safety net: re-open anything the containers' startup made root-owned
                    docker run --rm -v "$IDX:/x" debian:12-slim sh -c 'mkdir -p /x/artifacts && chmod -R a+rwX /x/artifacts'

                    docker exec "wi-build_$VER"    bash packaging_scripts/build.sh    -a x64 -d deb
                    docker exec "wi-assemble_$VER" bash packaging_scripts/assemble.sh -a x64 -d deb -r "$BUILD_NUMBER"

                    # assemble.sh drops the revision from the file name; put it (and the commit) back
                    cp -v "artifacts/dist/wazuh-indexer_${VER}_amd64.deb" \
                          "$OUT/wazuh-indexer_${VER}-${BUILD_NUMBER}_amd64_${SHORT}.deb"
                    bash "$CACHE_SH" put wazuh-indexer "$SHA" "$OUT/wazuh-indexer_${VER}-${BUILD_NUMBER}_amd64_${SHORT}.deb"
                '''
            }
        }

        stage('Build dashboard') {
            when { expression { params.BUILD_DASHBOARD } }
            steps {
                sh '''
                    set -e
                    D="$WORKSPACE/dashboard"
                    DSHA="$(cat "$WORKSPACE/wazuh-dashboard.sha")"
                    PSHA="$(cat "$WORKSPACE/wazuh-dashboard-plugins.sha")"
                    SSHA="$(cat "$WORKSPACE/wazuh-security-dashboards-plugin.sha")"
                    # The package depends on all three repos, so the cache key combines all three commits
                    KEY="$(echo "$DSHA" | cut -c1-12)-$(echo "$PSHA" | cut -c1-12)-$(echo "$SSHA" | cut -c1-12)"
                    if bash "$CACHE_SH" get wazuh-dashboard "$KEY"; then exit 0; fi

                    # Reuse the (slow) platform build if the wazuh-dashboard commit has not changed
                    SKIP=0
                    if [ -f "$D/.platform-sha" ] && [ "$(cat "$D/.platform-sha")" = "$DSHA" ] \
                       && ls "$D"/wazuh-dashboard/target/opensearch-dashboards-*-linux-x64.tar.gz >/dev/null 2>&1; then
                        SKIP=1
                    fi
                    if [ "$FORCE_DASHBOARD_PLATFORM" = "true" ]; then SKIP=0; fi
                    echo "Reuse dashboard platform: $SKIP"

                    GH="$(dirname "$(cat "$WORKSPACE/wazuh-dashboard.url")")" \
                    DASHBOARD_REF="$DSHA" \
                    PLUGINS_REF="$PSHA" \
                    SECURITY_REF="$SSHA" \
                    WORKDIR="$D" OUT="$OUT" REVISION="$BUILD_NUMBER" SKIP_PLATFORM="$SKIP" \
                    bash wazuh/build/scripts/build-dashboard.sh

                    echo "$DSHA" > "$D/.platform-sha"
                    bash "$CACHE_SH" put wazuh-dashboard "$KEY" "$OUT"/wazuh-dashboard_*.deb
                '''
            }
        }

        stage('Checksums & archive') {
            steps {
                sh '''
                    set -e
                    # Hand files back to the build user, drop debug packages unless asked, write fresh checksums
                    docker run --rm -v "$OUT:/out" debian:12-slim chown -R "$(id -u):$(id -g)" /out
                    cd "$OUT"
                    [ "$KEEP_DEBUG" = "true" ] || rm -f *-dbg_*.deb
                    rm -f *.sha512
                    for f in *.deb; do sha512sum "$f" > "$f.sha512"; done
                    ls -lh
                    sha512sum -c *.sha512
                '''
                archiveArtifacts artifacts: 'out/*.deb, out/*.sha512', fingerprint: true
            }
        }

        stage('Publish to repo') {
            when { expression { params.PUBLISH } }
            agent { label 'built-in' }      // the Jenkins VM, where /srv/wazuh-repo lives
            environment {
                REPO = '/srv/wazuh-repo'
                KEEP = '3'                  // versions to keep per package (indexer alone is ~835 MB each)
            }
            steps {
                sh 'rm -rf pub'
                unarchive mapping: ['out/': 'pub/']
                sh '''
                    set -e
                    cd pub
                    for f in $(find . -name '*.sha512'); do (cd "$(dirname "$f")" && sha512sum -c "$(basename "$f")"); done
                    find . -name '*.deb' -exec cp -v {} "$REPO/pool/" \\;

                    cd "$REPO"
                    # Keep only the newest $KEEP versions of each package
                    for pkg in $(ls pool/*.deb | xargs -n1 basename | cut -d_ -f1 | sort -u); do
                        ls -t pool/${pkg}_*.deb | tail -n +$((KEEP + 1)) | xargs -r rm -v
                    done

                    # Rebuild the apt index
                    dpkg-scanpackages --multiversion pool /dev/null 2>/dev/null > Packages
                    gzip -9c Packages > Packages.gz
                    echo "Repo now contains:"
                    grep -E '^(Package|Version):' Packages | paste - -
                '''
            }
        }
    }

    post {
        success {
            echo "Packages archived for build #${env.BUILD_NUMBER}."
        }
        always {
            // Free space on the build VM (packages are now in Jenkins); make sure indexer containers are stopped
            sh '''
                docker run --rm -v "$OUT:/out" debian:12-slim sh -c "rm -rf /out/*" || true
                if [ -d "$SRC/wazuh-indexer/docker/ci" ]; then (cd "$SRC/wazuh-indexer/docker/ci" && bash ./ci.sh stop) || true; fi
            '''
        }
    }
}
