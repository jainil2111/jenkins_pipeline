// Installs a Wazuh agent on an Ubuntu VM and enrolls it with an existing Wazuh server.
// Jenkins job: deploy-wazuh-agent   |   Script Path: wazuh/agent/Jenkinsfile
// Run deploy-wazuh-server first. Re-run this job once per machine you want to monitor.
// Re-enrolls automatically when the server was rebuilt (the manager no longer knows the agent).

pipeline {
    agent { label 'built-in' }     // Ansible lives on the Jenkins VM (not on the build VM)

    parameters {
        string(name: 'WAZUH_SERVER_IP', defaultValue: '192.168.11.21', description: 'IP of the existing Wazuh server')
        string(name: 'WAZUH_AGENT_IP',  defaultValue: '192.168.11.22', description: 'IP of the machine to install the agent on')
        string(name: 'AGENT_NAME',      defaultValue: 'wazuh-agent',   description: 'Name the agent registers with on the manager (unique, no spaces)')
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        ANSIBLE_HOST_KEY_CHECKING      = 'False'   // lab convenience
        ANSIBLE_CALLBACK_RESULT_FORMAT = 'yaml'
        ANSIBLE_TIMEOUT                = '30'      // SSH + sudo wait (default 10s is too short for a VM that just woke up)
        ANSIBLE_PIPELINING             = 'True'    // one SSH round-trip per task
        // Reuse one SSH connection per host within THIS build only (own folder per build), and drop it
        // fast if the host went away (sleep/reboot) - a stale shared connection makes every job hang.
        ANSIBLE_SSH_ARGS               = '-C -o ControlMaster=auto -o ControlPersist=60s -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o GSSAPIAuthentication=no'
        ANSIBLE_SSH_CONTROL_PATH_DIR   = "/tmp/ansible-cp-${env.BUILD_TAG}"
        LAB_REPO_URL                   = 'http://192.168.11.20/wazuh-repo'
        INVENTORY                      = 'wazuh/ansible/inventory.ini'
    }

    stages {
        stage('Generate inventory') {
            steps {
                writeFile file: env.INVENTORY, text: """\
[wazuh_server]
wazuh-server ansible_host=${params.WAZUH_SERVER_IP}

[wazuh_agents]
${params.AGENT_NAME} ansible_host=${params.WAZUH_AGENT_IP}

[all:vars]
ansible_python_interpreter=/usr/bin/python3
"""
                sh 'cat "$INVENTORY"'
            }
        }

        stage('Connectivity check') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'deploy-ssh-key',
                                                   keyFileVariable: 'SSH_KEY',
                                                   usernameVariable: 'SSH_USER')]) {
                    sh 'ansible all -i "$INVENTORY" -u "$SSH_USER" --private-key "$SSH_KEY" -b -m command -a "whoami"'
                }
            }
        }

        stage('Check Wazuh server is installed') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'deploy-ssh-key',
                                                   keyFileVariable: 'SSH_KEY',
                                                   usernameVariable: 'SSH_USER')]) {
                    sh '''
                        ansible wazuh_server -i "$INVENTORY" -u "$SSH_USER" --private-key "$SSH_KEY" -b \
                          -m command -a "/var/ossec/bin/wazuh-control info -v" \
                        || { echo "Wazuh server not found at $WAZUH_SERVER_IP - run the wazuh-server job first."; exit 1; }
                    '''
                }
            }
        }

        stage('Deploy Wazuh agent') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'deploy-ssh-key',
                                                   keyFileVariable: 'SSH_KEY',
                                                   usernameVariable: 'SSH_USER')]) {
                    sh 'ansible-playbook -i "$INVENTORY" wazuh/ansible/wazuh-agent.yml -u "$SSH_USER" --private-key "$SSH_KEY" -e lab_repo_url="$LAB_REPO_URL"'
                }
            }
        }

        stage('Verify agent is Active') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'deploy-ssh-key',
                                                   keyFileVariable: 'SSH_KEY',
                                                   usernameVariable: 'SSH_USER')]) {
                    sh 'ansible-playbook -i "$INVENTORY" wazuh/ansible/verify.yml -u "$SSH_USER" --private-key "$SSH_KEY"'
                }
            }
        }
    }

    post {
        always {
            sh 'rm -rf "$ANSIBLE_SSH_CONTROL_PATH_DIR" || true'
        }
        success {
            echo "Agent '${params.AGENT_NAME}' (${params.WAZUH_AGENT_IP}) is Active on https://${params.WAZUH_SERVER_IP}"
        }
    }
}
